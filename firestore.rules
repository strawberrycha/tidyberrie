rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owns(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function validProfile(data) {
      return data.version == 1 && data.encrypted is bool
        && ((data.encrypted == false && data.keys().hasOnly(['version', 'encrypted']))
          || (data.encrypted == true && data.keys().hasOnly(['version', 'encrypted', 'salt', 'verifier'])
            && data.salt is string && data.salt.size() == 24
            && data.verifier is string && data.verifier.size() <= 128));
    }

    function iso(value) {
      return value is string && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[.][0-9]{3}Z$');
    }

    function validRecord(uid, id, data) {
      return data.keys().hasOnly(['collection', 'updatedAt', 'deletedAt', 'deviceId', 'encrypted', 'payload', 'committedAt'])
        && data.collection in ['tasks', 'subtasks', 'taskExceptions', 'dayThemes', 'accounts', 'incomes',
          'expenses', 'transfers', 'categoryBudgets', 'goals', 'debts', 'budgetHistory', 'settings']
        && id.matches(data.collection + '__[a-zA-Z0-9_-]{1,80}')
        && iso(data.updatedAt)
        && (data.deletedAt == null || (data.collection != 'budgetHistory' && iso(data.deletedAt)))
        && data.deviceId is string && data.deviceId.matches('^[a-f0-9-]{36}$')
        && data.encrypted is bool
        && data.encrypted == get(/databases/$(database)/documents/users/$(uid)/sync/profile).data.encrypted
        && data.payload is string && data.payload.size() <= 131072
        && data.committedAt == request.time;
    }

    function newer(next, prior) {
      return next.updatedAt > prior.updatedAt
        || (next.updatedAt == prior.updatedAt && next.deviceId > prior.deviceId);
    }

    match /users/{uid}/sync/profile {
      allow get: if owns(uid);
      allow create: if owns(uid) && validProfile(request.resource.data);
    }

    match /users/{uid}/records/{recordId} {
      allow get: if owns(uid);
      allow list: if owns(uid) && request.query.limit <= 20;
      allow create: if owns(uid) && validRecord(uid, recordId, request.resource.data);
      allow update: if owns(uid) && resource.data.collection != 'budgetHistory'
        && request.resource.data.collection == resource.data.collection
        && validRecord(uid, recordId, request.resource.data)
        && newer(request.resource.data, resource.data);
    }
  }
}
